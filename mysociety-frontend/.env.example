# Copy to .env.local and adjust as needed. Only VITE_* vars reach the browser.

# Base URL of the MySociety backend API.
VITE_API_BASE_URL=http://localhost:8080/identity

# Development proxy target for API routes that use the Vite proxy.
VITE_API_PROXY_TARGET=http://localhost:8080

# Set to true only when using the in-memory mock API instead of the backend.
VITE_USE_MOCK_API=false

# Society (tenant) slug sent as the X-Society-Id header on every request.
VITE_DEFAULT_SOCIETY_ID=green-valley

# Simulated network latency (ms) for the mock API.
VITE_MOCK_LATENCY_MS=150
